# Copiar a infra/hia/.env. Credenciales exclusivas del laboratorio local.
POSTGRES_USER=convoca_lab
POSTGRES_PASSWORD=ConvocaLab2026
PGADMIN_EMAIL=lab@example.com
PGADMIN_PASSWORD=ConvocaLab2026
LAB_DB_PORT=5435
LAB_PGADMIN_PORT=5050
# Clave local para firmar sesiones de la API en el Compose de desarrollo.
# Generar una propia; no usar esta plantilla como secreto real.
API_JWT_SECRET=generar-una-clave-aleatoria-local
# Volúmenes v2 separados de Bitnami; no cambiar con datos cargados.
COMPOSE_PROJECT_NAME=convoca-lab-v2
