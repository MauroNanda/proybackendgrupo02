    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst source = $('Preparar incidencia y evitar duplicados').item.json;\nconst response = $json;\nconst issue = response.issue ?? response;\nconst issueId = issue.id ?? response.id;\nif (!issueId) {\n  throw new Error('Mantis respondió, pero no se pudo leer el ID de la incidencia.');\n}\nconst store = $getWorkflowStaticData('global');\nstore.alerts = store.alerts ?? {};\nstore.alerts[source.fingerprint] = {issueId, createdAt: new Date().toISOString(), summary: source.summary, raw: source.raw};\nreturn {json: {...source, issueId, action: 'created'}};\n"
      },
