        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $json;\nconst store = $getWorkflowStaticData('global');\nstore.alerts = store.alerts ?? {};\nconst previous = store.alerts[data.fingerprint];\nif (previous?.issueId) {\n  previous.raw=data.raw;\n  return {json: {...data, duplicate: true, issueId: previous.issueId}};\n}\nconst issue = {\n  summary: `[PROM] ${data.summary}`,\n  description: data.description,\n  project: {id: 1, name: 'Convoca - A11 reproducible'},\n  category: {name: data.category},\n  priority: data.priority,\n  severity: {id: 70, name: 'failure'},\n  reproducibility: {id: 100, name: 'unknown'},\n  handler: {name: data.handlerName},\n  view_state: {id: 50, name: 'private'}\n};\nreturn {json: {...data, duplicate: false, issue}};\n"
      },
