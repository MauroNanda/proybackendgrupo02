{
  "name": "A13 - Flujo 1 - Prometheus a Mantis y aviso",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "a13-flujo1-prometheus",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "3b525983-b700-46f8-98e8-91d3e8c8ffe5",
      "name": "Webhook Alertmanager",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "webhookId": "795d730c-4769-4f67-8a40-5aa0c4af5fb8"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst body = $json.body ?? $json;\nconst alerts = Array.isArray(body.alerts) ? body.alerts : [];\nif (!alerts.length) {\n  throw new Error('El webhook no contiene body.alerts. Enviar el payload de Alertmanager.');\n}\nreturn alerts.map((a) => {\n  const labels = a.labels ?? {};\n  const ann = a.annotations ?? {};\n  const name = labels.alertname ?? 'AlertaPrometheus';\n  const fingerprint = a.fingerprint ?? `${name}:${labels.instance ?? labels.job ?? 'general'}`;\n  const status = (a.status ?? body.status ?? 'firing').toLowerCase();\n  const sev = (labels.severity ?? 'warning').toLowerCase();\n\n  let category = labels.mantis_category ?? labels.category ?? '';\n  if (!category) {\n    if (/cpu|memoria|memory|disco|disk|rendimiento|latencia/i.test(name)) category = 'Rendimiento';\n    else if (/publicacion|proxy|nginx|http/i.test(name)) category = 'Publicacion';\n    else category = 'Disponibilidad';\n  }\n  const priority = category === 'Rendimiento' ? {id: 30, name: 'normal'} : {id: 40, name: 'high'};\n  const summary = (ann.summary ?? `${name} - ${labels.instance ?? labels.job ?? 'Convoca'}`).slice(0, 200);\n  const description = [\n    'Incidencia generada automáticamente desde una alerta de Prometheus (A13 - Flujo 1).',\n    `Alerta: ${name}`,\n    `Estado recibido: ${status}`,\n    `Fingerprint: ${fingerprint}`,\n    `Instancia: ${labels.instance ?? 'No informada'}`,\n    `Job: ${labels.job ?? 'No informado'}`,\n    `Severidad Prometheus: ${sev}`,\n    `Valor: ${a.value ?? 'No informado'}`,\n    `Inicio: ${a.startsAt ?? 'No informado'}`,\n    `Descripción: ${ann.description ?? 'Sin descripción adicional'}`,\n    '',\n    '[PROMETHEUS_FINGERPRINT:' + fingerprint + ']'\n  ].join('\\n');\n  return {\n    json: {\n      status, fingerprint, alertname: name, summary, description,\n      category, priority, handlerName: labels.handler ?? 'gabriel-calisaya',\n      instance: labels.instance ?? '', severity: sev,\n      startsAt: a.startsAt ?? '', endsAt: a.endsAt ?? '',\n      generatorURL: a.generatorURL ?? '', raw: a\n    }\n  };\n});\n"
      },
      "id": "727a313b-e120-4bd6-8778-e0a634c9a137",
      "name": "Normalizar alertas",
      "type": "n8n-nodes-base.code",
