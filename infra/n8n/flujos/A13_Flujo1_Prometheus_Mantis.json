      "id": "3b525983-b700-46f8-98e8-91d3e8c8ffe5",
      "name": "Webhook Alertmanager",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "8c452fb3-b450-4735-9d86-e1887d7ffc31",
      "credentials": {
        "httpHeaderAuth": {
          "id": "a13Webhook",
          "name": "A13 entrada protegida"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const output=[];\nfor(const input of $input.all()) {\nconst body = input.json.body ?? input.json;\nconst alerts = Array.isArray(body.alerts) ? body.alerts : [];\nif (!alerts.length || alerts.length > 20) {\n  throw new Error('El webhook no contiene body.alerts. Enviar el payload de Alertmanager.');\n}\noutput.push(...alerts.map((a) => {\n  if (!['firing','resolved'].includes(a.status ?? body.status)) throw new Error('Estado invalido');\nconst labels = a.labels ?? {};\nif (typeof labels.alertname !== 'string' || labels.alertname.length > 100) throw new Error('Alerta invalida');\n  const ann = a.annotations ?? {};\n  const name = labels.alertname ?? 'AlertaPrometheus';\n  const fingerprint = a.fingerprint ?? `${name}:${labels.instance ?? labels.job ?? 'general'}`;\n  if (typeof fingerprint !== 'string' || fingerprint.length > 2000 || ['__proto__','constructor','prototype'].includes(fingerprint)) throw new Error('Fingerprint invalido');\nconst status = (a.status ?? body.status ?? 'firing').toLowerCase();\n  const sev = (labels.severity ?? 'warning').toLowerCase();\n\n  let category = '';\n  if (!category) {\n    if (/cpu|memoria|memory|disco|disk|rendimiento|latencia/i.test(name)) category = 'Rendimiento';\n    else if (/publicacion|proxy|nginx|http/i.test(name)) category = 'Publicacion';\n    else category = 'Disponibilidad';\n  }\n  const priority = category === 'Rendimiento' ? {id: 30, name: 'normal'} : {id: 40, name: 'high'};\n  const summary = (ann.summary ?? `${name} - ${labels.instance ?? labels.job ?? 'Convoca'}`).slice(0, 200);\n  const description = [\n    'Incidencia generada automáticamente desde una alerta de Prometheus (A13 - Flujo 1).',\n    `Alerta: ${name}`,\n    `Estado recibido: ${status}`,\n    `Fingerprint: ${fingerprint}`,\n    `Instancia: ${labels.instance ?? 'No informada'}`,\n    `Job: ${labels.job ?? 'No informado'}`,\n    `Severidad Prometheus: ${sev}`,\n    `Valor: ${a.value ?? 'No informado'}`,\n    `Inicio: ${a.startsAt ?? 'No informado'}`,\n    `Descripción: ${ann.description ?? 'Sin descripción adicional'}`,\n    '',\n    '[PROMETHEUS_FINGERPRINT:' + fingerprint + ']'\n  ].join('\\n');\n  return {\n    json: {\n      status, fingerprint, alertname: name, summary, description,\n      category, priority, handlerName: 'gabriel-calisaya',\n      instance: labels.instance ?? '', severity: sev,\n      startsAt: a.startsAt ?? '', endsAt: a.endsAt ?? '',\n      generatorURL: a.generatorURL ?? '', raw: a\n    }\n  };\n}));\n}\nreturn output;"
      },
