      "id": "bab1e3d7-56bf-4709-ada0-e425bd59efea",
      "name": "Detectar altas y recuperaciones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -550,
        -250
      ],
      "parameters": {
        "jsCode": "if ($json.status !== 'success' || !Array.isArray($json.data?.alerts)) throw new Error('Prometheus invalido');\nconst store=$getWorkflowStaticData('global'); const antes=store.poll || {}; const ahora={}; const alerts=[];\nfor (const a of $json.data.alerts.filter(a=>a.state==='firing')) { const key=JSON.stringify(Object.entries(a.labels).sort()); const fp=Buffer.from(key).toString('base64url'); ahora[fp]=a; alerts.push({...a,status:'firing',fingerprint:fp}); }\nfor (const [fp,a] of Object.entries(antes)) if (!ahora[fp]) { alerts.push({...a,status:'resolved',fingerprint:fp}); if(store.alerts?.[fp]) ahora[fp]=a; }\nfor (const [fp,r] of Object.entries(store.alerts || {})) if (!ahora[fp] && !antes[fp] && r.raw) alerts.push({...r.raw,status:'resolved',fingerprint:fp});\nstore.poll=ahora; return alerts.map(a=>({json:{body:{alerts:[a]}}}));"
      }
    },
