        "jsCode": "\nconst data = $json;\nconst store = $getWorkflowStaticData('global');\nstore.alerts = store.alerts ?? {};\nconst record = store.alerts[data.fingerprint];\nif (!record?.issueId) {\n  return {json: {...data, found: false, action: 'recovery_without_open_issue'}};\n}\nreturn {json: {...data, found: true, issueId: record.issueId, action: 'resolved'}};\n"
      },
