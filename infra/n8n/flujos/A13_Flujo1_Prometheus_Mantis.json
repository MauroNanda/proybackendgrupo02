    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst source = $('Preparar incidencia y evitar duplicados').item.json;\nconst response = $json;\nconst issue = response.issue ?? response;\nconst issueId = issue.id ?? response.id;\nif (!issueId) {\n  throw new Error('Mantis respondió, pero no se pudo leer el ID de la incidencia.');\n}\nconst store = $getWorkflowStaticData('global');\nstore.alerts = store.alerts ?? {};\nstore.alerts[source.fingerprint] = {issueId, createdAt: new Date().toISOString(), summary: source.summary};\nreturn {json: {...source, issueId, action: 'created'}};\n"
      },
      "id": "6d1a4c0b-b1ea-41b4-8c25-a6922e9f333b",
      "name": "Guardar fingerprint e ID de Mantis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
