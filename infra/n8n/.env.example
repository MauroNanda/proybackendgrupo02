# Preparar con node scripts/n8n-lab.js preparar. No copiar claves de otra instancia.
N8N_ENCRYPTION_KEY=generar-localmente
N8N_RUNNER_TOKEN=generar-localmente
N8N_WEBHOOK_TOKEN=generar-localmente
N8N_SECURITY_WEBHOOK_TOKEN=generar-localmente
N8N_RUNNER_PORT=5681
N8N_PROMETHEUS_URL=http://host.docker.internal:9090
# Se guarda solo en la credencial cifrada local de n8n.
MANTIS_API_TOKEN=completar-localmente
NEXTCLOUD_USER=usuario4
NEXTCLOUD_PASSWORD=completar-localmente
